{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinjoh.com/schemas/deployment-manifest.schema.json",
  "title": "Sinjoh deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "network",
    "status",
    "releaseId",
    "sourceCommit",
    "deployedAt",
    "completedSteps",
    "contracts",
    "dependencies",
    "services",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chainId": { "enum": [4663, 46630] },
    "network": { "enum": ["robinhood-mainnet", "robinhood-testnet"] },
    "status": { "enum": ["not-deployed", "deployed", "superseded"] },
    "releaseId": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$" }
      ]
    },
    "sourceCommit": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      ]
    },
    "deployedAt": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "completedSteps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contracts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/contract" }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/contract" }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "enum": ["not-configured", "configured", "healthy", "degraded", "disabled"] },
          { "type": "object" }
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "runtimeCodeHash", "deploymentTransaction", "deploymentBlock"],
      "properties": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "runtimeCodeHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "deploymentTransaction": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "deploymentBlock": { "type": "integer", "minimum": 0 },
        "artifact": { "type": "string", "minLength": 1 },
        "constructorArguments": { "type": "array" },
        "verified": { "type": "boolean" }
      }
    }
  }
}

