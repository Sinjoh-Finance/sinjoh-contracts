{
  "$schema": "https://raw.githubusercontent.com/ethereum/clear-signing-erc7730-registry/master/specs/erc7730-v2.schema.json",
  "context": {
    "$id": "SinjohLaunchAuthorization",
    "eip712": {
      "deployments": [
        {
          "chainId": 46630,
          "address": "0x1160351B42ac027b9dFd3BFC497ee8985912c9dc"
        }
      ],
      "domain": {
        "name": "Sinjoh Launch",
        "version": "1",
        "chainId": 46630,
        "verifyingContract": "0x1160351B42ac027b9dFd3BFC497ee8985912c9dc"
      }
    }
  },
  "metadata": {
    "owner": "Sinjoh",
    "contractName": "Sinjoh Launch Authorization",
    "info": {
      "url": "https://sinjoh-ui.vercel.app"
    }
  },
  "display": {
