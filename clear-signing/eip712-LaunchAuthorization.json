      "LaunchAuthorization(string action,address wallet,string tokenName,string tokenSymbol,string artworkSha256,string routingSha256,string expiresAt)": {
        "$id": "LaunchAuthorization",
        "intent": "Authorize launch",
        "interpolatedIntent": "Authorize {tokenSymbol} launch",
        "fields": [
          {
            "path": "action",
            "label": "Authorization"
          },
          {
            "path": "wallet",
            "format": "addressName",
            "label": "Creator wallet",
            "params": {
              "types": ["eoa", "contract"],
              "sources": ["local"]
            }
          },
          {
            "path": "tokenName",
            "label": "Token name"
          },
          {
            "path": "tokenSymbol",
            "label": "Token ticker"
          },
          {
            "path": "artworkSha256",
            "label": "Artwork fingerprint"
          },
          {
            "path": "routingSha256",
            "label": "Routing fingerprint"
          },
          {
            "path": "expiresAt",
            "label": "Expires"
          }
        ]
      }
    }
  }
}
