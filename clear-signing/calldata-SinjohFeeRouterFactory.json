{
  "$schema": "https://raw.githubusercontent.com/ethereum/clear-signing-erc7730-registry/master/specs/erc7730-v2.schema.json",
  "context": {
    "$id": "SinjohFeeRouterFactory",
    "contract": {
      "deployments": [
        {
          "chainId": 4663,
          "address": "0xFA51E67f799699A237D558F5FbE7B170F8c5584d"
        }
      ]
    }
  },
  "metadata": {
    "owner": "Sinjoh",
    "contractName": "Sinjoh Fee Router Factory",
    "info": {
      "url": "https://sinjoh-ui.vercel.app"
    }
  },
  "display": {
    "formats": {
      "deployPons(address creator, bytes32 userSalt, (address creator, address protocolFeeRecipient, address weth, (address adapter, bytes routeData) subjectToWeth, ((uint8 kind, address token) output, uint16 bps, (address adapter, bytes routeData) route, (address destination, uint16 bps, bool isSink, bool creatorMayRepoint, bytes sinkConfig)[] allocations)[] buckets) config)": {
        "$id": "deployPons",
        "intent": "Deploy Pons fee router",
        "fields": [
          {
            "path": "creator",
            "format": "addressName",
            "label": "Token creator",
            "params": {
              "types": ["eoa"],
              "sources": ["local"]
            }
          },
          {
            "path": "config.protocolFeeRecipient",
            "format": "addressName",
            "label": "Protocol recipient",
            "params": {
              "types": ["eoa", "contract"],
              "sources": ["local"]
            }
          },
          {
            "path": "config.weth",
            "format": "tokenTicker",
            "label": "Routing base asset",
            "params": {
              "chainId": 4663
            }
          },
          {
            "path": "config.buckets",
            "label": "Immutable routing buckets",
            "fields": [
              {
                "path": "output.token",
                "format": "addressName",
                "label": "Output token",
                "params": {
                  "types": ["contract"],
                  "sources": ["local"]
                }
              },
              {
                "path": "bps",
                "format": "raw",
                "label": "Share (bps)"
              }
            ]
          },
          {
            "path": "userSalt",
            "label": "Deployment salt",
            "visible": "never"
          }
        ]
      }
    }
  }
}
