{
  "name": "@sinjoh/contracts-v2-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "fixtures"
  ],
  "scripts": {
    "generate:abis": "forge build -q --root .. && node ./scripts/generate-abis.mjs",
    "build": "npm run generate:abis && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm test"
  },
  "peerDependencies": {
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "viem": "2.55.19"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
