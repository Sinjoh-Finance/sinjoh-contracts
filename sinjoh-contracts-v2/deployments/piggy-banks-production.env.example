YIELD_BANK_PROTOCOL_REGISTRY=0x09e4542f9fEA13A00aAF400E81bDC10434af5278

# Piggy Banks collection configuration. These values are runtime inputs, not protocol constants.
YIELD_BANK_COLLECTION_NAME="Piggy Banks"
YIELD_BANK_COLLECTION_SYMBOL="PIGGY"
YIELD_BANK_COLLECTION_MAX_SUPPLY=3333
YIELD_BANK_COLLECTION_SALT=0xe947a74c920b669043f2d8558e11aef4722ec7e853f65339776262e350714759
YIELD_BANK_FEE_WEIGHT_ENDS=3,33,333,3333
YIELD_BANK_FEE_WEIGHTS=60,15,5,2

# All net primary proceeds back the newly minted banks. All secondary creator earnings
# are distributed by fee weight across the live banks. No additional exit tax is charged.
YIELD_BANK_SECONDARY_ROYALTY_BPS=1000
YIELD_BANK_PRIMARY_BACKING_BPS=10000
YIELD_BANK_PRIMARY_CREATOR_BPS=0
YIELD_BANK_PRIMARY_SINJOH_BPS=0
YIELD_BANK_ROYALTY_BACKING_BPS=10000
YIELD_BANK_ROYALTY_CREATOR_BPS=0
YIELD_BANK_ROYALTY_SINJOH_BPS=0
YIELD_BANK_EXIT_TAX_BPS=0

# New banks default to USDG. Holders can later request any valid three-sleeve allocation.
YIELD_BANK_CORE_WEIGHT_BPS=0
YIELD_BANK_MARKET_MAKING_WEIGHT_BPS=0
YIELD_BANK_USDG_WEIGHT_BPS=10000

# Production control addresses.
YIELD_BANK_COLLECTION_CREATOR=0x3d58E42d3a920dE4C1F71EE041c7eBb82ee23f49
