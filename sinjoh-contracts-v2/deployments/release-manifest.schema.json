{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinjoh.example/schemas/contracts-v2-release-manifest.json",
  "title": "Sinjoh Contracts v2 Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chainId",
    "protocolVersion",
    "gitCommit",
    "sourceTreeHash",
    "buildHash",
    "compiler",
    "evmVersion",
    "optimizerEnabled",
    "optimizerRuns",
    "viaIr",
    "auditReportVersion",
    "auditEvidence",
    "auditEvidenceHash",
    "forkEvidence",
    "forkEvidenceHash",
    "testnetEvidence",
    "testnetEvidenceHash",
    "roleEvidence",
    "roleEvidenceHash",
    "assetFlowEvidence",
    "assetFlowEvidenceHash",
    "broadcaster",
    "protocolFeeRecipient",
    "registry",
    "deploymentEngine",
    "launcher",
    "raffleImplementation",
    "basketVaultImplementation",
    "erc4626YieldAdapterFactory",
    "erc4626YieldAdapterRuntimeHash",
    "v3Factory",
    "v3FactoryRuntimeHash",
    "v3PositionManager",
    "v3PositionManagerRuntimeHash",
    "v4PositionManager",
    "v4PositionManagerRuntimeHash",
    "v4StateView",
    "v4StateViewRuntimeHash",
    "permit2",
    "permit2RuntimeHash",
    "tokenCreationCodeHash",
    "multisigCreationCodeHash",
    "timelockCreationCodeHash",
    "stakingCreationCodeHash",
    "treasuryCreationCodeHash",
    "airdropCreationCodeHash",
    "routerCreationCodeHash",
    "basketCreationCodeHash",
    "bandsCreationCodeHash",
    "liquidityCreationCodeHash",
    "integrationApprovalRoot",
    "registryRuntimeHash",
    "deploymentEngineRuntimeHash",
    "launcherRuntimeHash"
  ],
  "properties": {
    "chainId": { "type": "integer", "minimum": 1 },
    "protocolVersion": { "const": 2 },
    "gitCommit": { "$ref": "#/$defs/hash" },
    "sourceTreeHash": { "$ref": "#/$defs/hash" },
    "buildHash": { "$ref": "#/$defs/hash" },
    "compiler": { "const": "solc-0.8.28" },
    "evmVersion": { "const": "cancun" },
    "optimizerEnabled": { "const": true },
    "optimizerRuns": { "const": 1000 },
    "viaIr": { "const": true },
    "auditReportVersion": { "type": "string", "minLength": 1 },
    "auditEvidence": { "type": "string", "minLength": 1 },
    "auditEvidenceHash": { "$ref": "#/$defs/sha256" },
    "forkEvidence": { "type": "string", "minLength": 1 },
    "forkEvidenceHash": { "$ref": "#/$defs/sha256" },
    "testnetEvidence": { "type": "string", "minLength": 1 },
    "testnetEvidenceHash": { "$ref": "#/$defs/sha256" },
    "roleEvidence": { "type": "string", "minLength": 1 },
    "roleEvidenceHash": { "$ref": "#/$defs/sha256" },
    "assetFlowEvidence": { "type": "string", "minLength": 1 },
    "assetFlowEvidenceHash": { "$ref": "#/$defs/sha256" },
    "broadcaster": { "$ref": "#/$defs/address" },
    "protocolFeeRecipient": { "$ref": "#/$defs/address" },
    "registry": { "$ref": "#/$defs/address" },
    "deploymentEngine": { "$ref": "#/$defs/address" },
    "launcher": { "$ref": "#/$defs/address" },
    "raffleImplementation": { "$ref": "#/$defs/address" },
    "basketVaultImplementation": { "$ref": "#/$defs/address" },
    "erc4626YieldAdapterFactory": { "$ref": "#/$defs/address" },
    "erc4626YieldAdapterRuntimeHash": { "$ref": "#/$defs/bytes32" },
    "v3Factory": { "$ref": "#/$defs/address" },
    "v3FactoryRuntimeHash": { "$ref": "#/$defs/bytes32" },
    "v3PositionManager": { "$ref": "#/$defs/address" },
    "v3PositionManagerRuntimeHash": { "$ref": "#/$defs/bytes32" },
    "v4PositionManager": { "$ref": "#/$defs/address" },
    "v4PositionManagerRuntimeHash": { "$ref": "#/$defs/bytes32" },
    "v4StateView": { "$ref": "#/$defs/address" },
    "v4StateViewRuntimeHash": { "$ref": "#/$defs/bytes32" },
    "permit2": { "$ref": "#/$defs/address" },
    "permit2RuntimeHash": { "$ref": "#/$defs/bytes32" },
    "tokenCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "multisigCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "timelockCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "stakingCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "treasuryCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "airdropCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "routerCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "basketCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "bandsCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "liquidityCreationCodeHash": { "$ref": "#/$defs/bytes32" },
    "integrationApprovalRoot": { "$ref": "#/$defs/bytes32" },
    "registryRuntimeHash": { "$ref": "#/$defs/bytes32" },
    "deploymentEngineRuntimeHash": { "$ref": "#/$defs/bytes32" },
    "launcherRuntimeHash": { "$ref": "#/$defs/bytes32" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "hash": { "type": "string", "pattern": "^(0x)?[0-9a-fA-F]{40,64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}
